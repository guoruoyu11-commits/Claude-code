                "target": "_blank"
              },
              "v": "这里"
            },
            {
              "t": "br"
            },
            {
              "t": "#",
              "v": "\n【共通】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "红锁距离：上升(通常时:9→10/强化时10→11)"
            },
            {
              "t": "li",
              "v": "机动力：上升(凭体感，有待验证)"
            },
            {
              "t": "li",
              "v": "耐久值：上升(640→680)"
            },
            {
              "t": "li",
              "v": "副射击(共通)：变更为打空装填。"
            },
            {
              "t": "li",
              "v": "N副射击：取消到N副射击时，取消修正将重新生效。"
            },
            {
              "t": "li",
              "v": "各副射击射击派生：新增武装。类似于前作变形主射击的单发倒地射击。"
            },
            {
              "t": "li",
              "v": "变形主射击：前作变形特射指令移位。前作变形主射击被删除。"
            },
            {
              "t": "li",
              "v": "变形特殊射击：伴随上述变更的指令调整。与MS形态相同的死亡飞鱼召唤。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【通常时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "变形格斗CS：在变形中使用的M情况下，不会返回MS形态，而是无硬直地保持变形状态进行换装。觉醒技仍按惯例在MS形态下进行换装。"
            },
            {
              "t": "li",
              "v": "前格斗：初段威力下降(累计146→141)"
            },
            {
              "t": "li",
              "v": "横格斗：初段威力下降(累计173→168)"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【PL发动中】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "BD格斗：最终段变更为不可受身倒地。"
            },
            {
              "t": "li",
              "v": "N·横格特格派生：最终段变更为不可受身倒地。"
            },
            {
              "t": "li",
              "v": "后格斗：前作的特射（I力场之岚）移至此处。通常时的后格斗（斩击穿透）在强化中无法使用。"
            },
            {
              "t": "li",
              "v": "各特殊射击：伴随上述变更的指令调整。强化中也能召唤死亡飞鱼。"
            }
          ]
        }
