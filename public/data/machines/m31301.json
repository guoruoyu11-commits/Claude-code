":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"赤ロック距離"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"B"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_10"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"変形コマンド"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"なし"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_11"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"盾コマンド"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"あり"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_12"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"扱いやすさ"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"ノーマル"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_13"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"デフォルトBGM"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"THE FRONT"}]}]}]}]},{"t":"br"},{"t":"collapse","label":"▼目次","open":true,"c":[{"t":"div","a":{"class":"plugin_contents"},"c":[{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_057126df"},"v":"概要"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_33c8a07c"},"v":"EXバースト考察"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_25eb9077"},"v":"戦術"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_5b447b5d"},"v":"セットプレイ"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_bf07a260"},"v":"対面対策"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_ff69b207"},"v":"僚機考察"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_b0c3b81c"},"v":"適した僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_c81a9608"},"v":"適さない僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_fc8ca213"},"v":"コストパターンごとの戦術考察"}]}]}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9a051108"},"v":"外部リンク&参考資料集"}]}]}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_057126df"},"v":"概要"},{"t":"div","v":"『機動戦士ガンダム外伝 THE BLUE DESTINY』より、主人公のユウ・カジマが駆る第2部の主役機。\n陸戦型ガンダムをカスタムしたボディに「EXAMシステム」を搭載した陸戦型ジムの頭部を移植して開発され、名前の通り全身が青色に染められている。\n有線ミサイル等の追加武装も増設され、ベース機を凌ぐ戦闘能力を持つ。"},{"t":"br"},{"t":"div","v":"本シリーズでは実弾マシンガンを主力とした時限強化機。\nきちんとした性能のMGを手動リロードで無制限にばら撒き続け、多数存在するMGメイン機体の中でも特に「正しくMG機」していると言える。\nさらに伝統芸能とも言える特格を使った着キャン行動を駆使し、距離が離れた射撃戦なら安定行動もしやすい。 "},{"t":"br"},{"t":"div","v":"\n一方でEXAMシステム発動中は通常時から一転し、強襲性の高い格闘で相手に圧を掛けに行ける。 \n\n"},{"t":"br"},{"t":"div","v":"本作ではメインの弾数増加や即発射できるNサブの追加等、随所に強化が入っている。\n中でも大きな変更点として、初参戦時からの個性の1つであったEXAM中の格闘のラッシュ格闘仕様が廃止された。"},{"t":"br"},{"t":"div","v":"通常時は着キャンを駆使した射撃で冷静に立ち回り、\nEXAM時は高い強襲性能を活かして、『蒼い死神』の二つ名が示す恐怖を相手に叩き込んでやろう。"},{"t":"br"},{"t":"ul","c":[{"t":"li","v":"リザルトポーズ"}]},{"t":"div","v":"通常時:マシンガンを構えてポーズ。\nEXAM時勝利:右手のサーベルで袈裟斬りの後、サーベルを前に突き出す。\n敗北時:頭部が爆散して膝をつく。イフリート改と相討ちになったシーンの再現。"},{"t":"br"},{"t":"collapse","label":"▼前作からの変更点","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\n前作のデータは"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2ob/pages/129.html","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"赤ロック延長(前作単位表記で10→11)"},{"t":"li","v":"メイン射撃:弾数増加(40発→60発)。連射数増加(10連射→12連射)。"},{"t":"li","v":"サブ射撃(共通):Nサブに新規アクション追加(直射)。サブ射撃派生で弾数を消費するように。"}]},{"t":"div","v":"\n【通常時】\n\n"},{"t":"ul","c":[{"t":"li","v":"各格闘射撃派生:派生削除"}]},{"t":"div","v":"\n【EXAM発動時】\n\n"},{"t":"ul","c":[{"t":"li","v":"特殊格闘前格闘派生:前作前格闘がコマンド移行。"},{"t":"li","v":"格闘関連:ラッシュ仕様削除。通常タイプの格闘に変更。"},{"t":"li","v":"N格闘:2,3段目のダメージ増加(出し切りで180→192)。"},{"t":"li","v":"N・横格闘前派生:前作のN格2段目後派生が移動。ダメージ増加(N格2段目からの派生で230→290)。旧前派生は前格闘に移設。"},{"t":"li","v":"N・横格闘後派生:N格2段目からも後派生が出るように。ダメージ増加(N格1段目からの派生で171→175)。"},{"t":"li","v":"前格闘:アクション変更。前作の格闘前派生(クロブまでの前格)がコマンド移行。"},{"t":"li","v":"BD格闘:2,3,4段目のダメージ増加(出し切りで198→213)。"},{"t":"li","v":"特格中前格派生:旧前格のタックルに派生するように"}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_33c8a07c"},"v":"EXバースト考察"},{"t":"div","c":[{"t":"#","v":"\n｢EXAMsystem stand by.｣\n"},{"t":"br"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2infiniteboost/pages/33.html","title":"覚醒性能一覧 (27d)"},"v":"覚醒タイプ"},{"t":"#","v":":EXAM\n覚醒中はEXAMが強制発動する"}]},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"Fバースト"}]}]}]},{"t":"div","v":"格闘攻撃補正:+16%　防御補正:-15%\n最推奨。\n基本はこれ一択。EXAM中の強烈な格闘にF覚の追従性能上昇と覚醒タイプ補正が乗り、一瞬で高ダメージを叩き出す。\nオーバーリミット時のバリアと合わせればその爆発力は随一。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:blue;"},"v":"Sバースト"}]}]}]},{"t":"div","v":"射撃攻撃補正:+2%　\n非推奨。\nサブやジム投げからメイン降りが解放されるもののメインが手動リロのマシンガンなので相性が悪い。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:green;"},"v":"Eバースト"}]}]}]},{"t":"div","v":"防御補正:-30%\n非推奨。\n抜け覚醒でEXAMを発動できるが、今作の低コストは一芸あるなら攻め覚醒を選ぶことが主流なので、今作的には逆風。"},{"t":"br"},{"t":"h2","a":{"id":"id_25eb9077"},"v":"戦術"},{"t":"br"},{"t":"h2","a":{"id":"id_5b447b5d"},"v":"セットプレイ"},{"t":"br"},{"t":"h2","a":{"id":"id_bf07a260"},"v":"対面対策"},{"t":"br"},{"t":"h2","a":{"id":"id_ff69b207"},"v":"僚機考察"},{"t":"br"},{"t":"h3","a":{"id":"id_b0c3b81c"},"v":"適した僚機"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_c81a9608"},"v":"適さない僚機"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_fc8ca213"},"v":"コストパターンごとの戦術考察"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"3000"}]}]}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #ee7800;"},"v":"2500"}]}]}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #cb0;"},"v":"2000"}]}]}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #60EE3C;"},"v":"1500"}]}]}]},{"t":"br"},{"t":"br"},{"t":"h2","a":{"id":"id_9a051108"},"v":"外部リンク&参考資料集"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"https://jbbs.shitaraba.net/bbs/read.cgi/game/61485/1752376496/","rel":"nofollow","target":"_blank"},"v":"したらば掲示板 - ブルーディスティニー1号機 Part.1"}]}]},{"t":"br"}]}