i_tr_odd atwiki_tr_11"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"盾コマンド"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"あり"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_12"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"扱いやすさ"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"テクニカル"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_13"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"デフォルトBGM"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"ボスをたおせ"}]}]}]}]},{"t":"br"},{"t":"collapse","label":"▼目次","open":true,"c":[{"t":"div","a":{"class":"plugin_contents"},"c":[{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_057126df"},"v":"概要"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_33c8a07c"},"v":"EXバースト考察"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_25eb9077"},"v":"戦術"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_5b447b5d"},"v":"セットプレイ"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_bf07a260"},"v":"対面対策"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_ff69b207"},"v":"僚機考察"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_b0c3b81c"},"v":"適した僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_c81a9608"},"v":"適さない僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_fc8ca213"},"v":"コストパターンごとの戦術考察"}]}]}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9a051108"},"v":"外部リンク&参考資料集"}]}]}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_057126df"},"v":"概要"},{"t":"div","v":"ラクロアに突如現れたガンダム族の末裔。\n全体的なモーションはOVA版を意識しており、キャラクターボイスこそないが一部動作や石版使用時の効果音などが再現されている。\nリアルタイプのデザインは、PS3ゲーム「ガンダム無双3」に登場した「真・騎士ガンダム」とROBOT魂版を折衷させたアレンジ仕様。"},{"t":"br"},{"t":"div","v":"独自性の高い射撃と時限強化を持つ機体。\n通常時はMF式の地走だが、強化時は通常BDに変わるという珍しい特性を持つ。\n機動性にやや難のある通常時を耐え凌ぎ、派手な押し付け攻撃を揃えた強化時で一気に盤面を荒らすのが持ち味。\n時限強化でBD形式が変化する独特な操作感故に慣れが必要になるので、初めのうちはトレーニングモードで慣らし運転は必須。\n通常時のみジャンプするフレームが遅いのもにも慣れておこう。(通常時:7F、強化時:3F)"},{"t":"br"},{"t":"div","v":"共通調整としてサブに移動技が追加され、コマンド変更でいつでもカウンターが出せるようになった代わりに後格が前格に移動しBDから出しにくくなったほか、コンボパーツだった前格が連打対応の格闘前派生に変更になるなど、細かいところで調整は入っている。\n個別調整ではフルアーマーの武装に時限強化機らしくド派手な強化が入った。\n射程が統一された代わりに横移動を封鎖する3way火柱と、レバー入れで左右にズラせるようになった特格で制圧力が向上した。\n新要素のオーバーリミットは開幕時限強化を持たない本機と相性が悪く、フルアーマーに合わせる場合は覚醒技の空打ちかリロードを待たなければならない。"},{"t":"br"},{"t":"div","v":"強化時の3way火柱の2連発があまりに強力と判断されたか、2025/08/27、2025/11/04の二度に渡り、特射の回転率を中心とした下方修正が入った。 \nしかし、武装自体には修正は入っておらず、強化時は引き続き、なにかボタンを押せば相手が吹き飛ぶような大暴れが可能。\n通常時も移動技の追加で前作までよりも凌ぎやすくなっており、前派生の変更により格闘をねじ込めた際の火力も上がっている。\n強化時の活躍に加え、通常時にどれだけ上手く立ち回れるかが、安定した戦果を上げるためには重要と言えるだろう。"},{"t":"br"},{"t":"div","v":"\nどんな強敵にも勇者として臆することなく立ち向かい、正義は勝つことを教えてやろう。\n\n"},{"t":"br"},{"t":"ul","c":[{"t":"li","v":"リザルトポーズ"}]},{"t":"div","v":"いずれもキラカード風のエフェクトが発生する\n通常時:前に飛び込んで剣と盾を構える。カードダス(1)のイラスト再現。\nFA騎士時:突き上げた電磁ランスを向かって左に払う。カードダス(43)のイラスト再現。\n敗北時:煙を吹き出しつつ剣を地面に突き立てて項垂れ、肩で息をする。サタンガンダムに殴り飛ばされ起き上がった時の再現だが、石版解除後の反動も混ざっている。"},{"t":"br"},{"t":"collapse","label":"▼前作からの変更点","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\n前作のデータは"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2ob/pages/65.html","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"サブ射撃(全般):後サブ以外にナイトシールドor力の盾【サンドサーフィン】を新規導入。メインと各種格闘(後格以外)へのキャンセルルート有り。旧横サブのナイトシールドor力の盾【回転投擲】を削除。"},{"t":"li","v":"前格闘:旧後格闘(電磁スピア【突き上げ突撃】)がコマンド移動。旧前格は通常時の格闘前派生に仕様変更(連打対応)と共に移設。"},{"t":"li","v":"後格闘:旧後サブ射撃(カウンター)がコマンド移動。弾数無限化。"}]},{"t":"div","v":"\n【通常時】\n\n"},{"t":"ul","c":[{"t":"li","v":"後サブ射撃:前作Nサブ射撃(ナイトシールド【投擲】)がコマンド移動。"},{"t":"li","v":"N・横格闘前派生:前格が連打対応式の派生技に変更。"}]},{"t":"div","v":"\n【フルアーマー騎士ガンダム時】\n\n"},{"t":"ul","c":[{"t":"li","v":"後サブ射撃:前作Nサブ射撃(力の盾【照射】)がコマンド移動。"},{"t":"li","v":"N特殊射撃:スパークファイアが3way攻撃に変更。"},{"t":"li","v":"特殊格闘:レバー左右で投擲方向指定可能に変更。"}]}]},{"t":"collapse","label":"▼2025/08/27アップデート","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\nアップデート内容は"},{"t":"a","a":{"href":"https://web.vsmobile.jp/exvs2ib/news/detail/31","rel":"nofollow","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【フルアーマー騎士ガンダム時】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"特殊射撃(共通):弾数減少(2→1)。リロード時間調整(-3秒)。"}]}]},{"t":"collapse","label":"▼2025/11/04アップデート","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\nアップデート内容は"},{"t":"a","a":{"href":"https://web.vsmobile.jp/exvs2ib/news/detail/76","rel":"nofollow","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"耐久値:低下(700→680)。EXゲージの増加率上昇。"}]},{"t":"div","v":"\n【通常時】\n\n"},{"t":"ul","c":[{"t":"li","v":"機動力:低下。"}]},{"t":"div","v":"\n【フルアーマー騎士ガンダム時】\n\n"},{"t":"ul","c":[{"t":"li","v":"特殊射撃(共通):リロード時間延長(+1秒)。"}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_33c8a07c"},"v":"EXバースト考察"},{"t":"div","c":[{"t":"a","a":{"href":"//w.atwiki.jp/exvs2infiniteboost/pages/33.html","title":"覚醒性能一覧 (16d)"},"v":"覚醒タイプ"},{"t":"#","v":":ラクロアの勇者\n\n"}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"Fバースト"}]}]}]},{"t":"div","v":"格闘攻撃補正:+20%　防御補正:-15%\n推奨。\n補正の乗りが凄まじく、射撃始動でも簡単に300を超えるダメージを与えることができる。\nメインや特射からの格闘キャンセルも強力。\nオーバーリミットに強化も合わせれば、どんな相手でも粉砕できる。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:blue;"},"v":"Sバースト"}]}]}]},{"t":"div","v":"射撃攻撃補正:+4%\nメインは優秀とは言っても足を止める＆撃ち切りリロードという点で相性が悪く、キャンセルのシナジーも強くない。\n特射とサブが使い放題になるので、格闘拒否能力の高い相手や格闘機相手ならば選択肢に入るか。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:green;"},"v":"Eバースト"}]}]}]},{"t":"div","v":"防御補正:-30%\n先落ちできない組み合わせの時に使うとしても、落ちた後覚醒がないと強化に入れず苦しい。\n覚醒ゲージの供給も無いなかで、F覚醒(やS覚醒)の絶大な攻撃力を捨ててまで選ぶのは難しい。"},{"t":"br"},{"t":"h2","a":{"id":"id_25eb9077"},"v":"戦術"},{"t":"br"},{"t":"h2","a":{"id":"id_5b447b5d"},"v":"セットプレイ"},{"t":"br"},{"t":"h2","a":{"id":"id_bf07a260"},"v":"対面対策"},{"t":"br"},{"t":"h2","a":{"id":"id_ff69b207"},"v":"僚機考察"},{"t":"br"},{"t":"h3","a":{"id":"id_b0c3b81c"},"v":"適した僚機"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_c81a9608"},"v":"適さない僚機"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_f