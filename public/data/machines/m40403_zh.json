        {
          "t": "div",
          "v": "\n【BWS时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【MS时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "主射击：弹数调整(5发→4发)。可进行2连射。"
            },
            {
              "t": "li",
              "v": "副射击：弹数减少(2发→1发)。装填时间缩短(5秒→4秒)。"
            },
            {
              "t": "li",
              "v": "摇杆输入特殊射击：新增武装。并列发射4发。"
            }
          ]
        }
      ]
    },
