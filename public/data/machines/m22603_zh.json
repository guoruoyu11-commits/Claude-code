    {
      "source": "横特殊射撃:前作N特殊射撃が移行。銃口補正上昇。",
      "target": "横特殊射击：前作N特殊射击转移至此。枪口补正上升。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "前後特殊射撃:前作レバー入れ特殊射撃が移行。",
      "target": "前后特殊射击：前作摇杆输入特殊射击转移至此。",
      "method": "gemini",
