    },
    {
      "source": "N射撃CS:新規武装。その場で宙返りして前作のMS時レバー入れ射撃CS。",
      "target": "N射击CS：新增武装。在原地进行后空翻后发射前作MS形态下的方向键射击CS。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "前射撃CS:前作のMS時レバー入れ射撃CSが移行。",
      "target": "前射击CS：前作MS形态下的方向键射击CS移至此处。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "後射撃CS:前作のMS時N射撃CSが移行。後方に飛び込んでから撃つように。",
      "target": "后射击CS：前作MS形态下的N射击CS移至此处。变为向后跳跃后发射。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "Nサブ射撃:新規武装。前作のNサブ射撃と横特殊射撃を同時呼び出し。",
      "target": "N副射击：新增武装。同时呼出前作的N副射击和横特殊射击。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "前サブ射撃:前作の前後サブ射撃が移行。",
      "target": "前副射击：前作的前后副射击移至此处。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "後サブ射撃:前作のN特殊射撃が移行。",
      "target": "后副射击：前作的N特殊射击移至此处。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "後特殊射撃:前作の格闘CSが移行。",
      "target": "后特殊射击：前作的格斗CS移至此处。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "\n【MS時】\n\n",
      "target": "\n【MS形态时】\n\n",
      "method": "gemini",
