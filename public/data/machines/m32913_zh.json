                  "t": "span",
                  "a": {
                    "style": "color:green;"
                  },
                  "v": "E爆发"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "t": "div",
      "v": "防御补正:-%\n半觉能觉醒脱离。偷袭失手时或被殴时事故防止有用、但完全无火力补正、在缠Over Limit搅局强的本作是后向选项。"
