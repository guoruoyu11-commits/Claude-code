  "translation_log": [
    {
      "source": "\n※セラヴィーのN覚醒技をMA形態で後ろから当てると、2段目のキャノンのみが当たらず、結果的にダメージが上がるバグが存在する。\n\n",
      "target": "\n※炽天使N觉醒技以MA形态从后当、则第2段仅加农不中、结果伤害上升的bug存在。\n\n\n",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "防御補正:-%\n半覚で覚醒抜けができる。闇討ちをミスった時や殴られた時の事故防止には役に立つが火力補正が全くないこと、オバリミを絡めた荒らしがつよい本作では後ろ向きな選択肢。",
      "target": "防御补正:-%\n半觉能觉醒脱离。偷袭失手时或被殴时事故防止有用、但完全无火力补正、在缠Over Limit搅局强的本作是后向选项。",
      "method": "manual",
      "node_type": "div"
    }
  ]
}