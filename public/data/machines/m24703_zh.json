            {
              "t": "br"
            },
            {
              "t": "#",
              "v": "\n【基本形态】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "前后特格：旧后格斗的跳斩移动。"
            },
            {
              "t": "li",
              "v": "后格斗：旧特射的数据压制移动。"
            },
            {
              "t": "li",
              "v": "特殊射击：新增武装。使用吉他型光束步枪发射具有眩晕属性的照射光束。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【进化时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "前格斗：变更镜头运镜。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【极限时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "格斗CS：追加指令。直接放出过去作品中格斗特格派生的浮游大剑。可主射取消。"
            },
            {
              "t": "li",
              "v": "N副射展开中特殊射击：联动使浮游炮也进行照射。"
            },
            {
              "t": "li",
              "v": "格斗特格派生：删除。"
            }
          ]
        }
      ]
    },
