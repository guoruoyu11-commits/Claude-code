  ],
  "translation_log": [
    {
      "source": "総括",
      "target": "总括",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "ビルドダイバーズに加わったアヤメが駆る、SDガンダムのユニコーンガンダムをベースに改造したクノイチガンプラ。\n原型同様にマスクの開閉でのモードチェンジ(シノビ形態/カクレ形態)。さらにサポートメカ「武装装甲八鳥」と合体する事でリアル形態『忍闘-道』にも変形する。",
      "target": "加入Build Divers的文目驾驶的、以SD高达独角兽高达为基改造的女忍钢普拉。\n如原型以面罩开闭模式切换(忍形态/隐形态)。更与支援机械\"武装装甲八鸟\"合体、可变形为真实形态『忍斗-道』。",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "各特格:技中の被ダメ1.5倍効果削除。",
      "target": "各特格:删除技中被伤害1.5倍效果。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "変形:シノビ形態に変形を実装。",
      "target": "变形:忍形态实装变形。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "射撃CS:チャージ時間大幅延長(1.5秒→2.5秒)。出現中はCSゲージが消失するように。誘導低下。",
      "target": "射击CS:蓄力时间大幅延长(1.5秒→2.5秒)。存在中CS槽消失。诱导下降。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "N・横格闘前派生:前作の前格闘が移行。",
      "target": "N・横格斗前派生:前作前格斗移行。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "▼2026/11/04アップデート",
      "target": "▼2026/11/04更新",
      "method": "manual",
      "node_type": "collapse"
    },
    {
      "source": "特殊射撃(共通):リロード時間延長(6秒→7秒)。",
      "target": "特殊射击(共通):装填时间延长(6秒→7秒)。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "横特殊射撃:新規アクションを追加。変形時も共通。",
      "target": "横特殊射击:追加新动作。变形时也共通。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "前後特殊射撃:従来のレバー入れ特殊射撃がコマンド移行。シノビ形態の変形時は前特殊射撃で使用可能。",
      "target": "前后特殊射击:传统方向输入特殊射击指令移行。忍形态变形时前特殊射击可用。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "N覚醒技:技開始時に忍闘-道の弾数が回復するように変更。",
      "target": "N觉醒技:变更为技开始时回复忍斗-道的弹数。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "射撃CS:1hitよろけに変更。威力・補正率を再調整(累計:168→155)。レバー入力による方向制御を廃止。",
      "target": "射击CS:变更为1命中踉跄。再调整威力・补正率(累计:168→155)。废除方向输入方向控制。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "後サブ射撃:1射目の移動量上昇。1射目からもメイン射撃へのキャンセルルートを追加。追撃時の補正率緩和。",
      "target": "后副射击:第1射移动量上升。第1射起也追加到主射击的取消路线。追击时补正率缓和。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "変形メイン射撃:弾速・誘導性能を上昇。",
      "target": "变形主射击:弹速・诱导性能上升。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "変形特殊射撃(共通):変形特殊格闘へのキャンセルルートを追加。",
      "target": "变形特殊射击(共通):追加到变形特殊格斗的取消路线。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "変形特殊格闘:攻撃判定の出るタイミングを早く。誘導性能を再調整。",
      "target": "变形特殊格斗:攻击判定出时机变早。再调整诱导性能。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "N特殊格闘:追従性能上昇。",
      "target": "N特殊格斗:追击性能上升。",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "横特殊格闘:追従性能上昇。",
      "target": "横特殊格斗:追击性能上升。",
      "method": "manual",
      "node_type": "li"
