  ],
  "translation_log": [
    {
      "source": "\nと",
      "target": "和",
      "method": "norm",
      "node_type": "#"
    },
    {
      "source": "後格>特格→メイン(→特射→サブ→メイン)",
      "target": "后格>特格→主射(→特射→副射→主射)",
      "method": "combo",
      "node_type": "li"
    },
    {
      "source": "メイン→各サブ→メイン（→前格→射撃CS）",
      "target": "主射→各副射→主射（→前格→射击CS）",
      "method": "combo",
      "node_type": "li"
    },
    {
      "source": "各CS→レバ特射→Nサブ→メイン",
      "target": "各CS→方向特射→N副射→主射",
      "method": "combo",
      "node_type": "li"
    },
    {
      "source": "アースリィガンダム",
      "target": "大地高达",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "アースリィ",
      "target": "大地",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "ジュピターヴ",
      "target": "朱庇特维",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "ヒロト",
      "target": "希罗托",
      "method": "manual",
      "node_type": "td"
    },
    {
      "source": "アースリィ\nジュピターヴ",
      "target": "大地\n朱庇特维",
      "method": "manual",
      "node_type": "td"
    },
    {
      "source": "アースリィ時",
      "target": "大地形态时",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "ジュピターヴ時",
      "target": "朱庇特维形态时",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "CS関連",
      "target": "CS相关",
      "method": "manual",
      "node_type": "a"
    },
    {
      "source": "\n主人公クガ・ヒロトが",
      "target": "\n主人公久贺·希罗托从",
      "method": "manual",
      "node_type": "#"
    },
    {
      "source": "から着想を得て作成したガンプラ。\nコアガンダムを起点に、ミッション状況に応じて太陽系惑星の名を冠するアーマーを換装する「プラネッツシステム」を搭載している。",
      "target": "获得构想而制作出的钢普拉。\n以核心高达为起点、搭载根据任务状况换装冠以太阳系行星之名的装甲的\"行星系统\"。",
      "method": "manual",
      "node_type": "#"
    },
    {
      "source": "\n2500コストの換装機。\n\n",
      "target": "\n2500费用的换装机。\n",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "メアメキャン可能な万能機だがサブの使い方が試合を左右するアースリィ",
      "target": "可主射取消的万能机、但副射的用法左右比赛的大地",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "優秀なBMGと相方に貼れるバリアを持つ支援機寄りのジュピターヴ",
      "target": "兼备优秀的BMG与能给僚机贴屏障的、支援机倾向的朱庇特维",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "\nの2形態に加え、\n\n",
      "target": "\n的两形态之外、\n",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "地走系で回避力は落ちるが弾幕が強い射撃CSのヴィートルー",
      "target": "地走系、回避力下降但弹幕强的射击CS的维特罗",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "3段階派生による吶喊力を持ち火力も出る格闘CSのマーズフォー",
      "target": "持3阶段派生突击力、也能出火力的格斗CS的玛斯四号",
      "method": "manual",
      "node_type": "li"
    },
    {
      "source": "の2種の武装演出を持つ。\n比較的素直なジュピターヴだけでは2500としてのパワーを出せず、武装を当てるのが難しいアースリィやCSの強味をしっかり把握してようやくスタートラインという典型的なやり込み機体である。",
      "target": "的2种武装演出。\n光靠比较直白的朱庇特维出不了2500的power、把难命中武装的大地或CS的强项扎实掌握才终于算站上起跑线的典型钻研机体。",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "前作の下方後の性能をほぼ引き継いで継続参戦。\nアースリィのメインが2連射/4発となり、メアメキャンにより特化したのは分かりやすいポイント。\n一方で耐久が下がっており、3000の隣を担い順落ちは避けたい2500支援機としては悩ましいポイント。\n他方、全後衛機体共通の弱点である「耐久を残しすぎて相方ダブロでオバリミを発動できず負ける」展開に対して、両CSでどちらか一方は捕まえられる強襲力は悪くない追い風。",
      "target": "基本继承前作下调后的性能继续参战。\n大地主射变为2连射/4发、经主射取消特化是易懂的点。\n另一方面耐久下降、作为肩负3000侧翼、想避免顺落的2500支援机是头疼的点。\n另一方面、对全后卫机体共通弱点\"剩太多耐久、僚机被双锁无法发动Over Limit而败\"的展开、两CS哪边都能抓住一个的强袭力是不错的顺风。",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "\n各アーマーの性能を最大限に引き出し、数多の戦場を渡り歩こう。\n\n",
      "target": "\n最大限度引出各装甲的性能、驰骋于无数战场吧。\n",
      "method": "manual",
      "node_type": "div"
    },
    {
      "source": "格闘後派生、および覚醒技中はアースリィ判定。\nアースリィ時: ライフルを振り降ろしポーズ。1話等のドッキング後の再現。\nジュピターヴ時: マルチコンテナビットを展開しビームガトリングガンを構える。\nヴィートルー時: ビッグビームバズーカを構え銃口を発光させる。\nマーズフォー時: ハードヒートレヴソードを上から構える。3話の再現。\n敗北時:右腕を失ったコアガンダムが佇む。9話回想及び後期OPの再現。",
      "target": "格斗后派生、以及觉醒技中为大地判定。\n大地时: 挥下步枪摆pose。再现第1话等对接后。\n朱庇特维时: 展开多功能货柜浮游炮、架起光束加特林。\n维特罗时: 架起大型光束火箭炮、枪口发光。\n玛斯四号时: 从上方架起高热利刃大剑。再现第3话。\n败北时: 失去右臂的核心高达伫立。再现第9话回忆及后期OP。",
      "method": "manual",
      "node_type": "div"
    },
    {
