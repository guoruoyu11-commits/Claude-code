            {
              "t": "br"
            },
            {
              "t": "#",
              "v": "\n【基本形态】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "主射：删除至N特格的取消路线"
            },
            {
              "t": "li",
              "v": "前后特格：追加指令。前作后格斗的跳斩移动至此。"
            },
            {
              "t": "li",
              "v": "后格斗：前作特射的威压移动至此"
            },
            {
              "t": "li",
              "v": "特殊射击：新增武装。从吉他型光束步枪发射带麻痹属性的照射光束。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【极限时】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "特殊射击：追加射击派生。发射类似神斩的斩波。"
            },
            {
              "t": "li",
              "v": "特射N格斗派生：前作各种格斗后派生的抓取移动（闪光冲击）移动至此。连腿（飓风回旋踢）移动至特射横格斗派生。"
            },
            {
              "t": "li",
              "v": "各种格斗后派生：删除指令"
            }
          ]
        }
      ]
    },
    {
      "t": "br"
    },
