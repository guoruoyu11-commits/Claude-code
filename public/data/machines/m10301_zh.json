            {
              "t": "br"
            },
            {
              "t": "#",
              "v": "\n【共通】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "主射击：弹药数根据形态分别独立计算。"
            },
            {
              "t": "li",
              "v": "格斗CS：威力增加(266→282)"
            },
            {
              "t": "li",
              "v": "后觉醒技：新增武装。移行至强化型并附带爆风照射。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【全武装】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "主射击：与光束步枪（BR）联动，发射2发导弹。"
            },
            {
              "t": "li",
              "v": "N副射击：弹药消耗时机从导弹发射时变更为指令输入时。"
            },
            {
              "t": "li",
              "v": "前副射击：新增武装。突击时乱射导弹。"
            },
            {
              "t": "li",
              "v": "特殊射击：弹药数减少(2发→1发)。威力增加(239→264)"
            },
            {
              "t": "li",
              "v": "特殊格斗:追加到强化型各种格斗的取消路线。"
            },
            {
              "t": "li",
              "v": "格斗射击派生：加农炮部分从3连射变更为单发。威力增加(累计:220→247)。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【强化型】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "主射击：与全武装（FA）弹药独立。弹药调整(8发→7发)。"
            },
            {
              "t": "li",
              "v": "特殊射击：前作的后格斗移至此。旧特射的高能米加粒子炮已删除。"
            },
            {
              "t": "li",
              "v": "后格斗：前作的格斗前派生移至此。变更为浮空格斗的动作。"
            }
          ]
        }
      ]
    },
    {
      "t": "br"
    },
    {
