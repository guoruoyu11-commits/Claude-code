          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "耐久值:增加(680→720)。随之EX槽增加率下降。"
            },
            {
              "t": "li",
              "v": "N副射击:命中时敌机行动发生改变。同时重新调整威力、补正率、倒地值(1发累计:62→49)。"
            },
            {
              "t": "li",
              "v": "横副射击:弹数增加(1发→2发)。重新调整装填时间(7秒→8秒)。"
            },
            {
              "t": "li",
              "v": "特殊射击:追加了取消后施放各种格斗时追踪性能得到强化的机制。"
            },
            {
              "t": "li",
              "v": "N特殊格斗:节奏加快。调整视角。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【独角兽模式】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "射击CS(共通):旧NT-D中格斗CS指令移行。随之原有的射击CS被删除。"
            },
            {
              "t": "li",
              "v": "N射击CS:弯曲性能强化。"
            },
            {
              "t": "li",
              "v": "输入方向键射击CS:技能发动前移动速度继承量上升。"
            },
            {
              "t": "li",
              "v": "横格斗:调整命中时敌机行动。节奏加快。"
            },
            {
              "t": "li",
              "v": "BD格斗:第2段移动量上升。同时重新调整威力、补正率(累计:183→184)。节奏加快。调整视角。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【毁灭模式】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "机动力:上升。"
            },
            {
              "t": "li",
              "v": "主射击:发生缩短。变更为射击按钮追加输入可对应2连射。"
            },
            {
              "t": "li",
              "v": "副射击(共通):追加了取消至N·前·横特殊格斗的路线。"
            },
            {
              "t": "li",
              "v": "前后副射击:发生强化。"
            },
            {
              "t": "li",
