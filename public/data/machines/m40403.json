id_25eb9077"},"v":"戦術"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_5b447b5d"},"v":"セットプレイ"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_bf07a260"},"v":"対面対策"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_ff69b207"},"v":"僚機考察"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_b0c3b81c"},"v":"適した僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_c81a9608"},"v":"適さない僚機"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_fc8ca213"},"v":"コストパターンごとの戦術考察"}]}]}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9a051108"},"v":"外部リンク&参考資料集"}]}]}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_057126df"},"v":"概要"},{"t":"div","v":"Zガンダムの量産化を目指した装着変形式の半可変型MS。名前はリファイン・ガンダム・ゼータ(Refined・Gundam・Zeta)の頭文字の略称。\n劇中ではアムロ→ケーラの順で搭乗していたが、本シリーズでは作品終盤でアムロにサイコフレームの試料を渡すために搭乗したチェーン・アギ搭乗仕様。"},{"t":"br"},{"t":"div","v":"変形機動を強制されるバック・ウェポン・システム（以下、BWS）から始まり、時間経過か特射使用でMS形態に一方通行換装を行う機体。\nBWSは非常に高い攻撃性能を持っている反面、MS形態は全機体・全形態中でも最弱クラスという極めて極端なバランスとなっている。\nそして、ナドレやナラティブC装備のように初期形態を維持し続けることができないどころか、オデュッセウスのような時間経過による再装填も無く、必ず分離して再出撃までBWSは補充されないという、『永続弱体』機とも言うべき仕様。\nよって、BWSの性能でリードを奪う→MS形態でも積極的に動いてロックを取る→撃墜されてBWSで再出撃…という流れを繰り返す、コストセオリー度外視の変則爆弾戦術が求められがち。"},{"t":"br"},{"t":"div","v":"過去に爆弾機として暴れ回ったことを懸念されているのか、作品ごとの調整も控え目となっている機体。\n今作ではMS時にメインの連射対応と新規武装の追加で、主張しやすくする方針の調整が施された。"},{"t":"br"},{"t":"ul","c":[{"t":"li","v":"リザルトポーズ"}]},{"t":"div","v":"通常時：ビーム・サーベルを振り下ろす。\n覚醒時：躍動感あるポーズでビーム・ライフルを構える。\n敗北時：左腕と脚を失った状態で漂い、爆散。激昂したハサウェイのジェガンに撃たれた再現か。"},{"t":"br"},{"t":"collapse","label":"▼前作からの変更点","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\n前作のデータは"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2ob/pages/141.html","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"覚醒技:発動時に視点が自機に寄るように変更。"}]},{"t":"div","v":"\n【BWS時】\n\n"},{"t":"ul","c":[{"t":"li"}]},{"t":"div","v":"\n【MS時】\n\n"},{"t":"ul","c":[{"t":"li","v":"メイン射撃:弾数調整(5発→4発)。2連射可能に。"},{"t":"li","v":"サブ射撃:弾数減少(2発→1発)。リロード時間短縮(5秒→4秒)。"},{"t":"li","v":"レバー入れ特殊射撃:新規武装。4発を並列に発射。"}]}]},{"t":"collapse","label":"▼2026/03/26アップデート","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\nアップデート内容は"},{"t":"a","a":{"href":"https://web.vsmobile.jp/exvs2ib/news/detail/149","rel":"nofollow","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"覚醒技:不具合修正(コマンド入力後に視点が自機に向き続ける時間を短縮)"}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_33c8a07c"},"v":"EXバースト考察"},{"t":"div","c":[{"t":"#","v":"\n「ダメ！死んじゃう！！」\n"},{"t":"br"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2infiniteboost/pages/33.html","title":"覚醒性能一覧 (25d)"},"v":"覚醒タイプ"},{"t":"#","v":":バランス汎用\n\n"}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"Fバースト"}]}]}]},{"t":"div","v":"格闘攻撃補正:+8%　防御補正:-10%\n論外その1。広義の変形であるMAモードでは機動力の補正が乗らず、本機は格闘戦を仕掛ける機体ではない。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:blue;"},"v":"Sバースト"}]}]}]},{"t":"div","v":"射撃攻撃補正:+6%　\n推奨。1落ちから即覚醒し、BWS状態でメインを乱射して場を荒らすのが理想形。\nもちろん、状況に応じて戦術は変えるべきではある。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:green;"},"v":"Eバースト"}]}]}]},{"t":"div","v":"防御補正:-25%\n論外その2。\nBWS状態だと近接択が無いので相手に殴られた時のための保険にはなりそうだが覚醒抜けしてからBWSでの切り返し手段が覚醒技ブッパくらいしかない。\nそれをやるくらいなら被弾覚悟でS覚醒で荒らした方が余程マシだろう。"},{"t":"br"},{"t":"h2","a":{"id":"id_25eb9077"},"v":"戦術"},{"t":"br"},{"t":"h2","a":{"id":"id_5b447b5d"},"v":"セットプレイ"},{"t":"br"},{"t":"h2","a":{"id":"id_bf07a260"},"v":"対面対策"},{"t":"br"},{"t":"h2","a":{"id":"id_ff69b207"},"v":"僚機考察"},{"t":"br"},{"t":"h3","a":{"id":"id_b0c3b81c"},"v":"適した僚機"},{"t":"ul","c":[{"t":"li","v":"リガが放置された時に耐えれる自衛力を持った射撃より高コスト機体"}]},{"t":"div","v":"\nリガがMS形態になった途端十中八九放置されるので耐えれる機体かつ、格闘寄りだと後半に耐久を残しにくい＆前半は無理攻めできずにリガがダブロで落とされるので強烈な射撃を持つ機体が望ましい。\n\n"},{"t":"br"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_c81a9608"},"v":"適さない僚機"},{"t":"ul","c":[{"t":"li","v":"自衛力が低い機体"}]},{"t":"div","v":"\nリガが放置された時にダブロで落とされてしまうと満足にリガの火力を活かせずこちらの戦術も崩壊してしまう\n\n"},{"t":"br"},{"t":"br"},{"t":"br"},{"t":"br"},{"t":"h3","a":{"id":"id_fc8ca213"},"v":"コストパターンごとの戦術考察"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"3000"}]}]}]},{"t":"div","v":"推奨。とにかくリガが突貫して2機目のBWSと覚醒の併用で捲っていく。\n爆弾戦法をする場合、こちらのオバリミを発動するためにはリガが3回落ちないと発動できない点には注意。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #ee7800;"},"v":"2500"}]}]}]},{"t":"div","v":"\n前作までと違い事故気味。リガ放置からのオバリミ封じが特に怖い。\n\n"},{"t":"br"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #cb0;"},"v":"2000"}]}]}]},{"t":"div","v":"\n3000と組まないなら次点、覚醒回数の多さや落ち順も柔軟に決めやすいのは3000と違う利点。\n\n"},{"t":"br"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color: #60EE3C;"},"v":"1500"}]}]}]},{"t":"div","v":"\n事故、リガ放置から相方の15をガン攻めされるだけで試合が終わりかねない。\n\n"},{"t":"h2","a":{"id":"id_9a051108"},"v":"外部リンク&参考資料集"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"https://jbbs.shitaraba.net/bbs/read.cgi/game/61485/1752376428/l50","rel":"nofollow","target":"_blank"},"v":"したらば掲示板 - リ・ガズィ Part.1"}]}]},{"t":"br"}]}