      "method": "gemini",
      "node_type": "#"
    },
    {
      "source": "覚醒技:着弾点に爆風追加。曲げ撃ち非対応に。",
      "target": "觉醒技:着弹点追加爆风。不再支持曲射。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "特殊射撃(共通):新規武装。Gディフェンサー呼出",
      "target": "特殊射击(共通):新增武装。G防卫者召唤",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "後格闘:前作の射撃CSが移行。",
      "target": "后格斗:前作的射击CS转移。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "横格闘:新規モーション",
      "target": "横格斗:新动作",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "N・横格闘前派生:前作のN・横格闘後派生が移行。テンポ向上。",
      "target": "N・横格斗前派生:前作的N・横格斗后派生转移。节奏提升。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "N・横格闘後派生:前作の後格闘射撃派生が移行。",
      "target": "N・横格斗后派生:前作的后格斗射击派生转移。",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "N・横格闘横派生:削除",
      "target": "N・横格斗侧派生:删除",
      "method": "gemini",
      "node_type": "li"
    },
    {
      "source": "N・横格闘射撃派生:削除",
