特殊格闘"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;text-align:center;"},"v":"特殊移動"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"2"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"-"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"レバー横で挙動変化"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_5"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:KHAKI;"},"v":"覚醒技"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;text-align:center;background-color:GOLD;"},"v":"名称"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"弾数"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"威力\nF/S/E"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:GOLD;"},"v":"備考"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_6"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:VIOLET;"},"v":"覚醒技"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;text-align:center;"},"v":"ビルドブースター【一斉射撃】"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"1"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"射撃:170/182/170\n突進:108/100/100"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"ビームを撃ちながら突撃"}]}]}]},{"t":"br"},{"t":"collapse","label":"▼目次","open":true,"c":[{"t":"div","a":{"class":"plugin_contents"},"c":[{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_057126df"},"v":"概要"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_07583269"},"v":"キャンセルルート"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_1652746f"},"v":"射撃武器"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_c7c44774"},"v":"【メイン射撃・格闘】大型ビームキャノン【連射】"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_e9ea7ca0"},"v":"【サブ射撃・特殊射撃】大型ビームキャノン【照射】"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9f2f6836"},"v":"【特殊格闘】特殊移動"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_a2f0f106"},"v":"【N特殊格闘】垂直上昇"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_a13e1f10"},"v":"【横特殊格闘】水平移動"}]}]}]}]}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_15265135"},"v":"覚醒技"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_472ec16c"},"v":"【覚醒技】ビルドブースター【突進】"}]}]}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9a051108"},"v":"外部リンク&参考資料集"}]}]}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_057126df"},"v":"概要"},{"t":"div","v":"背部に装備されているビルドブースターに操作を切り替え、単独の戦闘機として戦う。ガーベラ・テトラ戦やザクアメイジング戦で登場した形態。\nコア・ファイターのようなものとは異なり、素体のビルドストライクに後付で追加された装備である。"},{"t":"br"},{"t":"div","v":"耐久値100の復活形態。\n変形機体のように飛び続けるがブーストボタンを押しても上昇・加速せず、高度が徐々に下がっていく性質がある。最後は地走機同然の回避力になってしまう。\n移動速度や旋回性は地味に優秀なので単なるBRや軸の合っていないアシスト程度なら回避できるが、誘導や銃口の強い武装やオールレンジ攻撃には無力。単純な格闘も脅威。"},{"t":"br"},{"t":"div","v":"「自衛は壊滅的だが闇撃ちにおいては上位コストも食える攻撃を叩き込む」というビルストらしい、最後の足掻きからの逆転に賭けた形態らしい性能。\n特に復活直後にカウンターをぶち込むための択は豊富で、無理に追ってきていた相手の硬直を狙った一発で勝利を掴み取ろう。"},{"t":"br"},{"t":"div","v":"2025/12/01のアップデートで特格の弾数が2になり、横特の追加で動きの幅は広がった。\n勘違いされがちだが、特格はどちらも誘導を切っていない。\n強誘導の弾は移動先まで追いかけてくることもあるので、使ったからといって安心はできない。"},{"t":"br"},{"t":"h2","a":{"id":"id_07583269"},"v":"キャンセルルート"},{"t":"ul","c":[{"t":"li","v":"メイン(格闘)、サブ(特射)→各特格"}]},{"t":"br"},{"t":"h2","a":{"id":"id_1652746f"},"v":"射撃武器"},{"t":"h3","a":{"id":"id_c7c44774"},"v":"【メイン射撃・格闘】大型ビームキャノン【連射】"},{"t":"div","v":"ビームキャノンを2門発射する。メイン、格闘どちらも同じで最大3連射可能。\n打ち切りリロードなので、可能な限り3連射1セットで撃ち切って回転率を上げたい。"},{"t":"br"},{"t":"table","c":[{"t":"tbody","c":[{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_1"},"c":[{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;background-color:KHAKI;text-align:center;"},"v":"リロード"},{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;background-color:GOLD;text-align:center;"},"v":"属性"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;background-color:GOLD;text-align:center;"},"v":"威力(補正率)"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"ダウン値"},{"