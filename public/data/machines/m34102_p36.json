"},{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"効果"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_2"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:GOLD;"},"v":"累計"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:GOLD;"},"v":"単発"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"累計"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"単発"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_3"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"?秒"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:SKYBLUE;"},"v":"照射ビーム"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"162(10%)"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"14(-10%)*2*10"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"5.0"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"0.25*2*10"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"ダウン"}]}]}]},{"t":"br"},{"t":"h3","a":{"id":"id_9f2f6836"},"v":"【特殊格闘】特殊移動"},{"t":"div","v":"回転しながら移動する回避行動。誘導切りの効果は無し。\nリロードは非常に長く、実質使い捨ての足掻き武装。覚醒リロードには対応しているので、これも含めた判断を心掛けたい。\n2025/12/01のアップデートで弾数が2に増加、レバー横入力が追加された。"},{"t":"br"},{"t":"table","c":[{"t":"tbody","c":[{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_1"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:KHAKI;"},"v":"リロード"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:GOLD;"},"v":"属性"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_2"},"c":[{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;"},"v":"撃ち切り?秒"},{"t":"td","a":{"style":"vertical-align:MIDDLE;text-align:center;background-color:YELLOW;"},"v":"特殊移動"}]}]}]},{"t":"br"},{"t":"h4","a":{"id":"id_a2f0f106"},"v":"【N特殊格闘】垂直上昇"},{"t":"div","v":"回転しながら1.5機分程度浮かび上がる。\n高度を回復できるが、地表の高さで使った後に再び下降しきってもリロードは完了しないので過信は出来ない。"},{"t":"br"},{"t":"h4","a":{"id":"id_a13e1f10"},"v":"【横特殊格闘】水平移動"},{"t":"div","v":"2025/12/01のアップデートで追加。高度を維持したまま横方向に大きく動く。\nN特格と異なり横方向に動くので、一瞬距離を離すのに使えるか。\nこの挙動の見た目であるに関わらずして、誘導は切っていない。\n回避する相手の弾の特性を把握しておかないとそのまま追いかけてくるので注意。"},{"t":"br"},{"t":"h2","a":{"id":"id_15265135"},"v":"覚醒技"},{"t":"h3","a":{"id":"id_472ec16c"},"v":"【覚醒技】ビルドブースター【突進】"},{"t":"div","c":[{"t":"span","a":{"style":"color: #3B4EF0;"},"v":"セ"},{"t":"#","v":"＆"},{"t":"span","a":{"style":"color: #F54738;"},"v":"レ"},{"t":"strong","v":"「これが"},{"t":"span","a":{"style":"color: #3B4EF0;"},"c":[{"t":"strong","v":"僕"}]},{"t":"#","v":"（"},{"t":"span","a":{"style":"color: #F54738;"},"c":[{"t":"strong","v":"俺"}]},{"t":"#","v":"）"},{"t":"strong","v":"達の、ガンプラだァァァア！！」"},{"t":"br"},{"t":"#","v":"ビームを連射しながら敵に向かって突撃する。\n本体自体にも単発の格闘判定が存在する。\n第6話のザクアメイジング戦におけるラストの再現。\n出だしに僅かながらSAあり。"}]},{"t":"br"},{"t":"div","v":"ビームはよろけ属性で誘導は及第点程度。軸のあった回避行動には何とか刺さる。\n本命は格闘判定部分。やたらと誘導も判定も強く、当たった相手を真上に打ち上げる。\n今作でも単発100以上のダメージが確認されており、お互いミリ耐久の場面でブースターを生格闘で仕留めに来た相手へのカウンターとして申し分ない性能を持つ。\nこれのためだけに覚醒を腐らせるのはご法度だが、ワンタッチで決まる大接戦では奥の手として機能するので覚えておきたい。"},{"t":"br"},{"t":"table","c":[{"t":"tbody","c":[{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_1"},"c":[{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;background-color:KHAKI;text-align:center;"},"v":"覚醒技"},{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;text-align:center;background-color:KHAKI;"},"v":"動作"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;background-color:GOLD;text-align:center;"},"v":"威力(補正率) F/S/E"},{"t":"td","a":{"colspan":"2","style":"vertical-align:MIDDLE;background-color:ORANGE;text-align:center;"},"v":"ダウン値"},{"t":"td","a":{"rowspan":"2","style":"vertical-align:MIDDLE;text-align:center;background-color:ORANGE;"},"v":"効果"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_2"},"c":[{"t":"td