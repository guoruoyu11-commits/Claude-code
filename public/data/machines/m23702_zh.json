                "href": "//w.atwiki.jp/exvs2ob/pages/345.html",
                "target": "_blank"
              },
              "v": "此处"
            },
            {
              "t": "br"
            },
            {
              "t": "#",
              "v": "\n【共通】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "耐久值：降低(680→640)"
            },
            {
              "t": "li",
              "v": "觉醒技：伤害数值调整(C觉：290→E觉：302)"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【宇宙用背包形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "N、横、BD格斗特格派生：拳击部分支持格斗键连打，最大伤害提升。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【反射器背包（共通）形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "各特殊格斗：旧后副射（蒙特罗呼叫）移动。变更为通过摇杆输入切换使用3种。"
            },
            {
              "t": "li",
              "v": "后格斗：旧特殊格斗（大气圈突入）移动。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【反射器背包（收纳）形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "格斗CS：计量条消耗时机变更为技能使用时。"
            },
            {
              "t": "li",
              "v": "前格斗：旧收纳中后格斗（冲撞）移动。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【突击背包形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "变形前特殊射击：追踪性能降低。"
            }
          ]
        }
      ]
    },
    {
      "t": "br"
    },
    {
      "t": "h2",
      "a": {
        "id": "id_33c8a07c"
      },
      "v": "EX爆发考察"
    },
    {
      "t": "div",
      "c": [
        {
          "t": "a",
          "a": {
            "href": "//w.atwiki.jp/exvs2infiniteboost/pages/33.html",
            "title": "覚醒性能一覧 (15d)"
          },
          "v": "觉醒类型"
        },
        {
          "t": "#",
          "v": ":平衡万用\n\n"
        }
      ]
    },
    {
      "t": "br"
    },
    {
      "t": "ul",
      "c": [
        {
          "t": "li",
          "c": [
            {
              "t": "span",
              "a": {
                "style": "font-weight: bold;"
              },
              "c": [
                {
                  "t": "span",
                  "a": {
                    "style": "color:red;"
                  },
                  "v": "F爆发"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "t": "div",
      "v": "格斗攻击补正：+%　防御补正：-%\n变形格斗过于大开大合，行动受限，鉴于MS格斗本身已足够强力，故此选项居次。\n在需要担任后卫时，可能会选择其以强化MS形态下的机动性。"
    },
    {
      "t": "br"
    },
    {
      "t": "ul",
      "c": [
        {
          "t": "li",
          "c": [
            {
              "t": "span",
              "a": {
                "style": "font-weight: bold;"
              },
              "c": [
                {
                  "t": "span",
                  "a": {
                    "style": "color:blue;"
                  },
                  "v": "S爆发"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "t": "div",
      "v": "射击攻击补正：+%\nC觉醒的供给觉醒路径消失后，S爆发成为唯一选择。\n通过解锁突击背包本已很高的射击间隔取消，可以持续倾泻射击武装。\n即使面对逃跑的对手，只要有推进和S觉醒，变形前特射就能无限循环，从而持续追击对手。\n另一方面，即使在无法维持变形的情况下，通过宇宙用高扭矩→主射或副射→主射取消连打，也能发挥出色的自卫能力，因此比E觉醒更为有用。"
    },
    {
      "t": "br"
    },
    {
      "t": "ul",
      "c": [
