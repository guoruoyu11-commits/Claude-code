            {
              "t": "#",
              "v": "\n【共通】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "耐久值：降低(680→640)"
            },
            {
              "t": "li",
              "v": "觉醒技:调整伤害推移(C觉:290→E觉:302)。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【宇宙用背包形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "横格斗:第3段伤害微增(累计167→170)。"
            },
            {
              "t": "li",
              "v": "N、横、BD格斗特格派生：拳击部分支持格斗键连打，最大伤害提升。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【反射器背包（共通）形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "各特殊格斗：旧后副射（蒙特罗呼叫）移动。变更为通过摇杆输入切换使用3种。"
            },
            {
              "t": "li",
              "v": "后格斗：旧特殊格斗（大气圈突入）移动。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【反射器背包（收纳）形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "格斗CS:槽消耗时机变更技使用时(完全1出击1回用完武装化)。"
            },
            {
              "t": "li",
              "v": "前格斗:旧收纳中后格斗(冲撞)移行。随之删除旧前格斗。威力低下(90→80)。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【突击背包形态】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "机动性：降低"
            },
            {
              "t": "li",
              "v": "变形前特殊射击：追踪性能降低。"
            },
            {
              "t": "li",
              "v": "变形格斗:伤害低下(120→100)。"
            }
          ]
        }
      ]
    },
    {
      "t": "br"
    },
