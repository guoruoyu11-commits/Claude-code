":"atwiki_tr_even atwiki_tr_10"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"変形コマンド"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"あり"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_11"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"盾コマンド"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"あり"}]},{"t":"tr","a":{"class":"atwiki_tr_even atwiki_tr_12"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"扱いやすさ"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"ノーマル"}]},{"t":"tr","a":{"class":"atwiki_tr_odd atwiki_tr_13"},"c":[{"t":"td","a":{"class":"table_style_1_column_1","style":"vertical-align:MIDDLE;"},"v":"デフォルトBGM"},{"t":"td","a":{"style":"vertical-align:MIDDLE;"},"v":"ガンダムAGE-2-運命の先へ"}]}]}]}]},{"t":"br"},{"t":"collapse","label":"▼目次","open":true,"c":[{"t":"div","a":{"class":"plugin_contents"},"c":[{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"#id_057126df"},"v":"概要"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_33c8a07c"},"v":"EXバースト考察"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_25eb9077"},"v":"戦術"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_bf07a260"},"v":"対面対策"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_ff69b207"},"v":"僚機考察"}]},{"t":"li","c":[{"t":"a","a":{"href":"#id_9a051108"},"v":"外部リンク&参考資料集"}]}]}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_057126df"},"v":"概要"},{"t":"div","v":"アセム編の主人公でフリットの息子アセム・アスノが搭乗する、第2世代機となる第二のガンダムAGE。\nAGE-1の蓄積データを元にしており、AGE2はアセム自身のパイロット特性を活かして提示され対複数戦向けのダブルバレット形態、および変形機構となるストライダー形態を持つ。"},{"t":"br"},{"t":"div","v":"\n本シリーズでは原作通り変形と換装を併せ持つ数少ない機体。\n\n"},{"t":"ul","c":[{"t":"li","v":"降りテクや機動力は及第点だが弾が弱く変形突撃による闇討ちが求められるノーマル"},{"t":"li","v":"足回りは悪いが遠近問わず圧のある武装を持つダブルバレット（以下DB）"}]},{"t":"div","v":"を使い分けて戦う可変換装機。\n過去作から共通して、どちらか一方の形態に拘り過ぎると必ずボロが出る設計になっており、\n両MS形態はもちろん各変形も効果的に使いまわすことが求められる文字通りの換装機となっている。\nノーマルの射撃力不足・DBの弾数制特格の存在から鑑みて、アセムらしい両前衛運用が得意な機体。"},{"t":"br"},{"t":"div","v":"前作は共通調整の影響でやや不遇よりな機体であったが、今作はDBの高火力派生を筆頭としたテコ入れや新システムのオーバーリミット（以下オバリミ）によるゴリ押しを見込める低コ格闘機よりのこの機体には追い風の環境となっている。\nそしてSAからオバリミのバリアまで何でも潰せるDBのN特格の回転斬りの存在から、オバリミの攻防に於いてめっぽう強い機体として一部で注目されている。\n唯一の下方要素も両形態の横格の威力推移が最終段寄り変更されコンボ火力が若干落ちた程度。"},{"t":"br"},{"t":"div","v":"ただ、バリアを使わずに格闘距離まで接近しようにもDB形態の足回りでは難しく、かといってノーマルで無理に突撃しても返り討ち…\nと従来の難点そのものは改善されておらず、フルスペックで戦うには機体性能の熟知が求められる職人寄りの性格はそのままである。"},{"t":"br"},{"t":"div","v":"\n多数の形態を的確に使いこなす巧みな立ち回りで、スーパーパイロットへの道を突き進もう。\n\n"},{"t":"br"},{"t":"ul","c":[{"t":"li","v":"リザルトポーズ"}]},{"t":"div","v":"ノーマル勝利時:アセム編OP冒頭の Hドッズライフルを構えるポーズ。\nDB勝利時:通常・DBそれぞれ二本の計四本のビームサーベルを展開する。\n敗北時:シドに大破させられた姿となる。特務隊カラーだとよりTV版に近くなる。"},{"t":"br"},{"t":"collapse","label":"▼前作からの変更点","open":true,"c":[{"t":"div","c":[{"t":"#","v":"\n前作のデータは"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2ob/pages/325.html","target":"_blank"},"v":"こちら"},{"t":"br"},{"t":"#","v":"\n【共通】\n\n"}]},{"t":"ul","c":[{"t":"li","v":"前特殊射撃:威力上昇(70→80)"}]},{"t":"div","v":"\n【ノーマル】\n\n"},{"t":"ul","c":[{"t":"li","v":"レバー入れサブ射撃:新規モーション。袈裟斬り→斬り抜け。"},{"t":"li","v":"格闘後派生:新規派生。二刀振り下ろし→右袈裟2段→横薙ぎ→X字逆袈裟→突き。"},{"t":"li","v":"格闘前派生:削除"},{"t":"li","v":"格闘特格派生:削除"},{"t":"li","v":"横格闘:ダメージ推移変更(累計:171→170)"}]},{"t":"div","v":"\n【ダブルバレット】\n\n"},{"t":"ul","c":[{"t":"li","v":"変形サブ射撃:新規武装。ノーマル形態通常時の特格にミサイルが追加された強化版。"},{"t":"li","v":"N・横格闘後派生:新規武装。新規モーション(キャンセル不可の高火力派生)。"},{"t":"li","v":"横格闘:ダメージ推移変更(累計:233→232)"}]}]},{"t":"br"},{"t":"h2","a":{"id":"id_33c8a07c"},"v":"EXバースト考察"},{"t":"div","c":[{"t":"#","v":"\n「スーパーパイロットを舐めるなァァァ！」\n"},{"t":"br"},{"t":"a","a":{"href":"//w.atwiki.jp/exvs2infiniteboost/pages/33.html","title":"覚醒性能一覧 (41d)"},"v":"覚醒タイプ"},{"t":"#","v":":射撃寄り汎用1\nAGE組唯一の非Xラウンダーの為、覚醒タイプがXラウンダーではない。"}]},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:red;"},"v":"Fバースト"}]}]}]},{"t":"div","v":"格闘攻撃補正:+4%　防御補正:-20% ブースト軽減:-15%\n推奨覚醒1。\n機動力と格闘の火力が上がり本機の(特にDB時)火力が更に高まる。\nオバリミバリアと合わせるとN特格が3025のコスオバ機体をバリアごと一瞬で溶かす凶武装と化す。\n倒しきれなかった場合にもダウン拾いから攻め継続or覚醒技に繋げれば3020の後落ちすら蒸発させる。\n但し相手のカウンターにはご用心。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:blue;"},"v":"Sバースト"}]}]}]},{"t":"div","v":"射撃攻撃補正:+8% ブースト軽減:-10%\n推奨覚醒2。\nノーマル・DBどちらでも相性が良い。\nDBは特格の高速リロードにより主力の特格を贅沢に回していける点を活かしたい。"},{"t":"br"},{"t":"ul","c":[{"t":"li","c":[{"t":"span","a":{"style":"font-weight: bold;"},"c":[{"t":"span","a":{"style":"color:green;"},"v":"Eバースト"}]}]}]},{"t":"div","v":"防御補正:-20%\n現時点では非推奨か。\n今作のE覚醒は覚醒による恩恵を受けずとも十分なリターンを取れる機体や体力低下による時限換装を安定化させたり、先落ち適正が無い機体が事故を防ぎ手堅く勝利する為の覚醒という気質があり、上級者向け。\n機体性能的にどうしてもリスクを取って近距離戦を行わなければ空気なりやすいので30と組んだ時、どうしても後落ちしたい、または攻める際へのリスクヘッジ⋯と言えば聞こえはいいが余りにも後ろ向き過ぎる為、非推奨。"},{"t":"br"},{"t":"div","v":"\n本機はF・S覚醒に十分な恩恵があり先落ちでも覚醒による巻き返しは十分に可能なので、耐久調整が崩された場合はいっそ先落ちに切替えて、ForS覚醒で暴れた方がいい結果になりやすい。\n\n"},{"t":"h2","a":{"id":"id_25eb9077"},"v":"戦術"},{"t":"br"},{"t":"h2","a":{"id":"id_bf07a260"},"v":"対面対策"},{"t":"br"},{"t":"br"},{"t":"h2","a":{"id":"id_ff69b207"},"v":"僚機考察"},{"t":"br"},{"t":"br"},{"t":"h2","a":{"id":"id_9a051108"},"v":"外部リンク&参考資料集"},{"t":"ul","c":[{"t":"li","c":[{"t":"a","a":{"href":"https://jbbs.shitaraba.net/bbs/read.cgi/game/61485/1752375372/l50","rel":"nofollow","target":"_blank"},"v":"したらば掲示板 - ガンダムAGE-2 Part.1"}]}]},{"t":"br"}]}