            },
            {
              "t": "#",
              "v": "\n【共通】\n\n"
            }
          ]
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "摇杆特殊射击：突进距离提升。"
            },
            {
              "t": "li",
              "v": "N觉醒技：新增强制换装为毁灭模式后施展的乱舞技。原有的连续射击改为后觉醒技。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【独角兽模式】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "副射击(通用)：弹药数增加(1发→2发)。各副射击→横向副射击的取消路线复活。"
            },
            {
              "t": "li",
              "v": "特殊格斗：威力增加(100→110)。改为强制倒地。"
            },
            {
              "t": "li",
              "v": "N格斗：威力变化变更(总伤害:177→177)。"
            }
          ]
        },
        {
          "t": "div",
          "v": "\n【毁灭模式】\n\n"
        },
        {
          "t": "ul",
          "c": [
            {
              "t": "li",
              "v": "后格斗：武装名称变更(光束拐棍【光束射出】→光束拐棍【冲击波】)。废止发射限制(即使有已发射弹药残留也能发射)。命中时能够贯穿敌人。冲击波命中前即可移行至格斗派生。"
            }
          ]
        }
      ]
    },
